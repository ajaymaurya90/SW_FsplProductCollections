{
    "name": "fspl/fspl-product-collections",
    "description": "Reusable CMS product collections: New Arrivals, Trending, Featured, Seasonal",
    "type": "shopware-platform-plugin",
    "version": "1.0.0",
    "license": "MIT",
    "require": {
        "shopware/core": "~6.7.0"
    },
    "extra": {
        "shopware-plugin-class": "Fspl\\ProductCollections\\FsplProductCollections",
        "label": {
            "de-DE": "FSPL Produktkollektionen",
            "en-GB": "FSPL Product Collections"
        }
    },
    "autoload": {
        "psr-4": {
            "Fspl\\ProductCollections\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fspl\\ProductCollections\\Tests\\": "tests/"
        }
    }
}
