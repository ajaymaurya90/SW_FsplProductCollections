{% block element_fspl_product_collections %}
    <div style="border: 2px solid red; padding: 20px;">


    {% set products = element.data %}



    {% if products is empty %}
        <p>No products found</p>
    {% endif %}

    <div class="fspl-product-collections fspl-product-collections--{{ element.config.collectionType.value }}">
        <div class="fspl-product-collections__grid">

            {% for product in products %}
                {% block element_fspl_product_collections_item %}
                    <div class="fspl-product-collections__item">

                        {% sw_include '@Storefront/storefront/component/product/card/box.html.twig' with {
                            product: product,
                            layout: 'standard'
                        } %}

                    </div>
                {% endblock %}
            {% endfor %}

        </div>
    </div>
    </div>
{% endblock %}

